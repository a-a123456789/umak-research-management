[Unit]
Description=CRM deletion ledger export and private object cleanup
OnFailure=crm-backup-alert.service

[Service]
Type=oneshot
User=crm-backup
WorkingDirectory=/opt/crm
EnvironmentFile=/etc/crm/backup.env
ExecStart=/usr/bin/node /opt/crm/scripts/privacy-maintenance.js
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict

