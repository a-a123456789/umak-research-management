  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.test/crm/algorithm-request.schema.json",
  "description": "Structural contract. Python additionally enforces references, unique evidence IDs, aggregate 50000 memberships, matching duration keys, DAG and consistent completed state. Transport body limit is 2 MiB."
}
