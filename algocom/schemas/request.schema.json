      "maxProperties": 5000,
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,64}$"
            },
            "gate": {
              "enum": [
                "received",
                "verified"
              ]
            }
          },
          "required": [
            "id",
            "gate"
          ],
          "additionalProperties": false
        },
        "maxItems": 50000,
        "uniqueItems": true
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "state": {
            "enum": [
              "received",
              "verified"
            ]
          }
        },
        "required": [
          "id",
          "state"
        ],
        "additionalProperties": false
      },
      "maxItems": 50000,
      "uniqueItems": true
    },
    "durations": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{1,64}$"
      },
      "minProperties": 1,
      "maxProperties": 5000,
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 525600
      }
    }
  },
  "required": [
    "steps",
    "dependencies",
    "completed_actions",
    "requirements",
    "evidence",
    "durations"
