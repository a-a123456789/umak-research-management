{
  "type": "object",
  "properties": {
    "steps": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{1,64}$"
      },
      "minItems": 1,
      "maxItems": 5000,
      "uniqueItems": true
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          }
        ],
        "minItems": 2,
        "maxItems": 2
      },
      "maxItems": 25000,
      "uniqueItems": true
    },
    "completed_actions": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{1,64}$"
      },
      "maxItems": 5000,
      "uniqueItems": true
    },
    "requirements": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{1,64}$"
